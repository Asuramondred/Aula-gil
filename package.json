{
  "name": "aula-agil",
  "private": true,
  "version": "1.0.0",
  "description": "AulaÁgil: libreta escolar de escritorio 100% local para docentes de primaria con generación de Word (.docx) e IA gratuita.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server release",
    "lint": "tsc --noEmit",
    "electron:dev": "electron .",
    "electron:build": "vite build && npm run build:server && electron-builder --win --config electron-builder.yml",
    "electron:build:mac": "vite build && npm run build:server && electron-builder --mac --config electron-builder.yml",
    "electron:publish": "vite build && npm run build:server && electron-builder --win --config electron-builder.yml -p always"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/file-saver": "^2.0.7",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.16.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.11",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "firebase": "^13.4.0",
    "googleapis": "^190.0.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sql.js": "^1.17.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
