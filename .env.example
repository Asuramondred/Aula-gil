# GEMINI_API_KEY: Llave gratuita de Google AI Studio (gemini-2.5-flash).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Respaldo gratuito opcional (Llama 3.3 70B en Groq).
GROQ_API_KEY=""

# APP_URL: URL base cuando se ejecuta en entorno web.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET: Credenciales OAuth opcionales para vincular cuenta de GitHub en actualizaciones.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
